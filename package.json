{
  "name": "nestjs-grpc-microservices",
  "version": "1.0.0",
  "description": "NestJS gRPC microservices POC with API gateway, user service, and order service",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "nest build api-gateway && nest build user-service && nest build order-service",
    "build:api-gateway": "nest build api-gateway",
    "build:user-service": "nest build user-service",
    "build:order-service": "nest build order-service",
    "start:api-gateway": "nest start api-gateway",
    "start:user-service": "nest start user-service",
    "start:order-service": "nest start order-service",
    "start:api-gateway:dev": "nest start api-gateway --watch",
    "start:user-service:dev": "nest start user-service --watch",
    "start:order-service:dev": "nest start order-service --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/microservices": "^11.1.29",
    "@nestjs/platform-express": "^11.1.29",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}

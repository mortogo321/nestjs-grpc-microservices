{
  "name": "nestjs-grpc-microservices",
  "version": "1.0.0",
  "description": "NestJS gRPC Microservices POC with API Gateway, User Service, and Order Service",
  "private": true,
  "scripts": {
    "build": "nest build",
    "build:api-gateway": "nest build api-gateway",
    "build:user-service": "nest build user-service",
    "build:order-service": "nest build order-service",
    "start:api-gateway": "nest start api-gateway --watch",
    "start:user-service": "nest start user-service --watch",
    "start:order-service": "nest start order-service --watch",
    "start:api-gateway:prod": "node dist/apps/api-gateway/main.js",
    "start:user-service:prod": "node dist/apps/user-service/main.js",
    "start:order-service:prod": "node dist/apps/order-service/main.js"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.12",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

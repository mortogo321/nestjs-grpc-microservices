{
  "name": "nestjs-grpc-microservices",
  "version": "1.0.0",
  "description": "NestJS gRPC microservices POC with API gateway, user service, and order service",
  "private": true,
  "scripts": {
    "build": "nest build api-gateway && nest build user-service && nest build order-service",
    "build:api-gateway": "nest build api-gateway",
    "build:user-service": "nest build user-service",
    "build:order-service": "nest build order-service",
    "start:api-gateway": "nest start api-gateway",
    "start:user-service": "nest start user-service",
    "start:order-service": "nest start order-service",
    "start:api-gateway:dev": "nest start api-gateway --watch",
    "start:user-service:dev": "nest start user-service --watch",
    "start:order-service:dev": "nest start order-service --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@grpc/proto-loader": "^0.7.12",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/microservices": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
